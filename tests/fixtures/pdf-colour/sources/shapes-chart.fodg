<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.graphics">
 <office:font-face-decls><style:font-face style:name="Liberation Sans" svg:font-family="'Liberation Sans'"/></office:font-face-decls>
 <office:styles>
  <style:default-style style:family="graphic"><style:graphic-properties draw:stroke="none" draw:fill="none"/><style:text-properties style:font-name="Liberation Sans" fo:font-size="12pt"/></style:default-style>
 </office:styles>
 <office:automatic-styles>
  <style:page-layout style:name="pm1"><style:page-layout-properties fo:page-width="21cm" fo:page-height="14.85cm" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:margin-left="0cm" fo:margin-right="0cm"/></style:page-layout>
  <style:style style:name="dp1" style:family="drawing-page"><style:drawing-page-properties draw:background-size="border" draw:fill="none"/></style:style>
  <style:style style:name="band" style:family="graphic"><style:graphic-properties draw:stroke="none" draw:fill="solid" draw:fill-color="#0d47a1"/><style:paragraph-properties fo:text-align="start"/><style:text-properties fo:color="#ffffff" fo:font-size="22pt" fo:font-weight="bold"/></style:style>
  <style:style style:name="bar1" style:family="graphic"><style:graphic-properties draw:stroke="none" draw:fill="solid" draw:fill-color="#1976d2"/></style:style>
  <style:style style:name="bar2" style:family="graphic"><style:graphic-properties draw:stroke="solid" svg:stroke-color="#8e0000" svg:stroke-width="0.05cm" draw:fill="solid" draw:fill-color="#e53935"/></style:style>
  <style:style style:name="bar3" style:family="graphic"><style:graphic-properties draw:stroke="none" draw:fill="solid" draw:fill-color="#43a047"/></style:style>
  <style:style style:name="bar4" style:family="graphic"><style:graphic-properties draw:stroke="none" draw:fill="solid" draw:fill-color="#fb8c00"/></style:style>
  <style:style style:name="axis" style:family="graphic"><style:graphic-properties draw:stroke="solid" svg:stroke-width="0.04cm" svg:stroke-color="#37474f"/></style:style>
  <style:style style:name="grid" style:family="graphic"><style:graphic-properties draw:stroke="solid" svg:stroke-width="0.01cm" svg:stroke-color="#b0bec5"/></style:style>
  <style:style style:name="tri" style:family="graphic"><style:graphic-properties draw:stroke="solid" svg:stroke-width="0.06cm" svg:stroke-color="#4a148c" draw:fill="solid" draw:fill-color="#ce93d8"/></style:style>
  <style:style style:name="ell" style:family="graphic"><style:graphic-properties draw:stroke="solid" svg:stroke-width="0.05cm" svg:stroke-color="#006064" draw:fill="solid" draw:fill-color="#80deea"/></style:style>
  <style:style style:name="lbl" style:family="graphic"><style:graphic-properties draw:stroke="none" draw:fill="none"/><style:text-properties fo:font-size="11pt" fo:color="#212121"/></style:style>
  <style:style style:name="lblred" style:family="graphic"><style:graphic-properties draw:stroke="none" draw:fill="none"/><style:text-properties fo:font-size="11pt" fo:color="#c62828" fo:font-weight="bold"/></style:style>
 </office:automatic-styles>
 <office:master-styles><style:master-page style:name="Standard" style:page-layout-name="pm1" draw:style-name="dp1"/></office:master-styles>
 <office:body><office:drawing><draw:page draw:name="Chart" draw:style-name="dp1" draw:master-page-name="Standard">
  <draw:rect draw:style-name="band" svg:x="0cm" svg:y="0cm" svg:width="21cm" svg:height="2.4cm"><text:p>Harbour traffic by quarter</text:p></draw:rect>
  <draw:line draw:style-name="grid" svg:x1="2cm" svg:y1="4cm" svg:x2="14cm" svg:y2="4cm"/>
  <draw:line draw:style-name="grid" svg:x1="2cm" svg:y1="6cm" svg:x2="14cm" svg:y2="6cm"/>
  <draw:line draw:style-name="grid" svg:x1="2cm" svg:y1="8cm" svg:x2="14cm" svg:y2="8cm"/>
  <draw:line draw:style-name="grid" svg:x1="2cm" svg:y1="10cm" svg:x2="14cm" svg:y2="10cm"/>
  <draw:rect draw:style-name="bar1" svg:x="3cm" svg:y="7cm" svg:width="1.8cm" svg:height="5cm"/>
  <draw:rect draw:style-name="bar2" svg:x="5.6cm" svg:y="5cm" svg:width="1.8cm" svg:height="7cm"/>
  <draw:rect draw:style-name="bar3" svg:x="8.2cm" svg:y="8.5cm" svg:width="1.8cm" svg:height="3.5cm"/>
  <draw:rect draw:style-name="bar4" svg:x="10.8cm" svg:y="4.5cm" svg:width="1.8cm" svg:height="7.5cm"/>
  <draw:line draw:style-name="axis" svg:x1="2cm" svg:y1="3.5cm" svg:x2="2cm" svg:y2="12cm"/>
  <draw:line draw:style-name="axis" svg:x1="2cm" svg:y1="12cm" svg:x2="14cm" svg:y2="12cm"/>
  <draw:custom-shape draw:style-name="lbl" svg:x="2.6cm" svg:y="12.1cm" svg:width="3cm" svg:height="0.8cm"><text:p>Q1</text:p><draw:enhanced-geometry draw:type="rectangle" draw:enhanced-path="M 0 0 L 21600 0 21600 21600 0 21600 0 0 Z N"/></draw:custom-shape>
  <draw:frame draw:style-name="lbl" svg:x="5.2cm" svg:y="12.1cm" svg:width="2.6cm" svg:height="0.8cm"><draw:text-box><text:p>Q2</text:p></draw:text-box></draw:frame>
  <draw:frame draw:style-name="lbl" svg:x="7.8cm" svg:y="12.1cm" svg:width="2.6cm" svg:height="0.8cm"><draw:text-box><text:p>Q3</text:p></draw:text-box></draw:frame>
  <draw:frame draw:style-name="lblred" svg:x="10.4cm" svg:y="12.1cm" svg:width="2.6cm" svg:height="0.8cm"><draw:text-box><text:p>Q4 peak</text:p></draw:text-box></draw:frame>
  <draw:polygon draw:style-name="tri" svg:viewBox="0 0 400 400" svg:x="15.2cm" svg:y="4cm" svg:width="4cm" svg:height="4cm" draw:points="200,0 400,400 0,400"/>
  <draw:ellipse draw:style-name="ell" svg:x="15.2cm" svg:y="8.8cm" svg:width="4cm" svg:height="3cm"/>
 </draw:page></office:drawing></office:body>
</office:document>
