# Generated from src/lib/config/schema.ts by `npm run config:docs`. Do not edit by hand.
#
# Copy this file to .env and fill in the lines without a leading #. The other lines show optional
# variables with their default; remove the # to change one. An empty value counts as unset. Secrets
# are never given a default value: generate each with `openssl rand -hex 32`. The same text with the
# rule of every variable is in docs/configuration.md.

# --- Runtime ---

# Any non-empty value declares that the process already runs inside a container sandbox.
# Rule: text.
# CONTAINER_SANDBOX=

# glibc allocator arena limit per process. When set (for example to `2` in the worker container),
# the image pipeline may lease up to 8 threads instead of the unbounded-heap cap of 2.
# Rule: integer, 1 to 2147483647.
# MALLOC_ARENA_MAX=

# --- Network and public URLs ---

# Public origin of this application, used to build the URLs of local-driver uploads. Required in
# production when STORAGE_DRIVER is `local`.
# Rule: URL with the scheme http or https.
# Development default: http://localhost:3000.
# APP_URL=

# Canonical origin used for OAuth redirects and the same-origin check of the API; takes precedence
# over NEXT_PUBLIC_APP_URL.
# Rule: URL with the scheme http or https.
# APP_ORIGIN=

# Port of the metrics listener (GET /metrics), which every process opens beside its own service. `0`
# turns the listener off. It is not the web application's port and must not be published or proxied
# (docs/slo.md).
# Rule: integer, 0 to 65535.
# Default: 9464 in the web process, 9465 in the worker.
# METRICS_PORT=

# Address the metrics listener binds to. The default is the loopback address; the container stack
# sets `0.0.0.0` so that a scraper on the internal compose network can reach it.
# Rule: text.
# METRICS_HOST=127.0.0.1

# Public origin exposed to the browser; used when APP_ORIGIN is not set.
# Rule: URL with the scheme http or https.
# NEXT_PUBLIC_APP_URL=

# --- Client address trust and sandbox ---

# Set to `true` to refuse running native tools without the strict process sandbox.
# Rule: true or false.
# STRICT_SANDBOX=false

# Set to `false` to start sandboxed programs without `pid-init` (on by default): without the PID
# namespace of their own, and without the Landlock ruleset that refuses them the /proc entries
# (command line, status) of the other runs. calibre and veraPDF always run outside the PID
# namespace: calibre's launcher reads /proc/<its own id>/exe, which names another process in a
# namespace whose /proc the sandbox cannot remount; they still get the ruleset.
# Rule: true or false.
# SANDBOX_PID_NAMESPACE=true

# Set to `false` to start sandboxed programs without the Landlock ruleset that refuses them the
# /proc entries (command line, status) of the other runs (on by default; `pid-init --keep-proc`).
# The PID namespace stays. A single call can opt out with `sandboxOptions.hideProc: false`.
# Rule: true or false.
# SANDBOX_HIDE_PROC=true

# Whether sandboxed native tools are started by the persistent low-heap launcher process instead of
# forked directly from the worker. `auto` (the default) uses the launcher when available and falls
# back to a direct start; `off` always starts programs directly.
# Rule: one of auto, off (any case).
# SANDBOX_LAUNCHER=auto

# Whether the public http and https images of an HTML page are fetched and embedded when it is
# converted to PDF. `on` (the default) fetches them in a separate, credential-free child process
# that needs outbound TCP 80 and 443 to public addresses (see docker/AIRGAP.md for the network
# policy). `off` for deployments without egress: no image is fetched, and each external image is
# left out of the PDF with a warning (a request with `requireResources` is refused).
# Rule: one of on, off (any case).
# HTML_IMAGE_FETCH=on

# Comma-separated IPv4/IPv6 addresses or CIDR ranges of the reverse proxies in front of the server,
# or `none` for a directly exposed server. Production should declare one of TRUSTED_PROXIES or
# TRUSTED_CDN; the edge middleware answers API requests with 503 until it does
# (docs/client-ip-trust.md).
# Rule: comma-separated IPv4/IPv6 addresses or CIDR ranges or none, at most 256 entries.
# TRUSTED_PROXIES=

# Name of the CDN whose edge ranges are trusted to forward client addresses.
# Rule: one of cloudflare (any case).
# TRUSTED_CDN=

# CIDR ranges that replace the built-in edge ranges of TRUSTED_CDN.
# Rule: comma-separated IPv4/IPv6 addresses or CIDR ranges, at most 256 entries.
# TRUSTED_CDN_RANGES=

# The one forwarding header the trusted proxy writes: `x-forwarded-for` (default) or `forwarded`.
# Rule: one of x-forwarded-for, forwarded (any case).
# TRUSTED_PROXY_HEADER=

# --- Sign-in ---

# Signs session tokens. At least 32 bytes of UTF-8 text in production; also a legacy decryption
# fallback key of the credential vault and of API key secret encryption.
# Rule: secret, at least 32 bytes of UTF-8 text in production (the text is measured, never decoded).
JWT_SECRET=

# The previous JWT_SECRET during a key rotation, so session tokens signed under it still verify
# while new tokens are signed with JWT_SECRET. Used exactly as set, like JWT_SECRET, without
# trimming.
# Rule: secret, at least 32 bytes of UTF-8 text in production (the text is measured, never decoded).
# JWT_SECRET_PREVIOUS=

# OAuth client id for Google sign-in. Without it, development uses a local mock sign-in and
# production refuses to sign in.
# Rule: text.
# GOOGLE_CLIENT_ID=

# OAuth client secret for Google sign-in; required together with GOOGLE_CLIENT_ID.
# Rule: secret text.
# GOOGLE_CLIENT_SECRET=

# SMTP server that sends the password reset and email verification mails (STARTTLS is required, a
# mail is never sent in the clear). Without SMTP_HOST, SMTP_USER and SMTP_PASSWORD, and a public
# origin (APP_ORIGIN, NEXT_PUBLIC_APP_URL or APP_URL), both features are off: the sign-in page shows
# no forgot-password link and their routes answer 404.
# Rule: text.
# SMTP_HOST=

# Port of SMTP_HOST. 587 (STARTTLS) is the default; 465 connects over TLS from the first byte.
# Rule: integer, 1 to 65535.
# SMTP_PORT=587

# Account that signs in to SMTP_HOST: the full account address (for a mailbox provider, not a short
# name).
# Rule: secret text.
# SMTP_USER=

# Password of SMTP_USER: an application password, not the sign-in password of the account.
# Rule: secret text.
# SMTP_PASSWORD=

# Sender of the mails: an address, or `Name <address>`. Defaults to SMTP_USER. A mailbox provider
# accepts only the account or one of its aliases.
# Rule: text.
# MAIL_FROM=

# --- Keys and secrets ---

# Pepper of the HMAC that hashes API key secrets. At least 32 bytes of UTF-8 text in production.
# Also a legacy decryption fallback key of API key secret encryption.
# Rule: secret, at least 32 bytes of UTF-8 text in production (the text is measured, never decoded).
KEY_HASH_PEPPER=

# The previous KEY_HASH_PEPPER during a rotation, so API keys hashed under it still verify and are
# re-hashed under KEY_HASH_PEPPER on next use.
# Rule: secret, at least 32 bytes of UTF-8 text in production (the text is measured, never decoded).
# KEY_HASH_PEPPER_PREVIOUS=

# Key that encrypts API key webhook secrets at rest. In production it must be set (at least 32
# characters) to encrypt a new secret; without it existing secrets still decrypt under
# KEY_HASH_PEPPER, KEY_HASH_PEPPER_PREVIOUS or JWT_SECRET. Outside production those keys also
# encrypt.
# Rule: secret, at least 32 bytes of UTF-8 text in production (the text is measured, never decoded).
# KEY_ENCRYPTION_KEY=

# Key-encryption key of the webhook signing secrets. At least 32 bytes of UTF-8 text in production.
# The web process seals the rotated secrets with it and the worker opens them to sign every
# delivery, so both need the same value.
# Rule: secret, at least 32 bytes of UTF-8 text in production (the text is measured, never decoded).
WEBHOOK_SECRET_KEK=

# Master key of the vault that holds customer storage credentials. In production it must be set (at
# least 32 characters) to store credentials; without it stored credentials still decrypt under
# KEY_ENCRYPTION_KEY or JWT_SECRET. Outside production those keys also encrypt.
# Rule: secret, at least 32 bytes of UTF-8 text in production (the text is measured, never decoded).
# STORAGE_VAULT_KEY=

# Key-encryption key that seals signed URLs and headers inside queued jobs. At least 32 bytes of
# UTF-8 text, no surrounding whitespace, in production. Shared by the API and every worker.
# Rule: secret, at least 32 bytes of UTF-8 text in production (the text is measured, never decoded), no surrounding whitespace in production.
JOB_SECRET_KEK=

# The previous JOB_SECRET_KEK during a rotation, so jobs sealed under it can still be opened.
# Rule: secret, at least 32 bytes of UTF-8 text in production (the text is measured, never decoded), no surrounding whitespace in production.
# JOB_SECRET_KEK_PREVIOUS=

# --- Object storage ---

# Where objects live: `oci` (OCI Object Storage), `s3` (an S3-compatible service) or `local` (disk
# of this host, for development and single-node use). Must be chosen in production.
# Rule: one of oci, s3, local (any case).
# Development default: local.
STORAGE_DRIVER=

# Signs upload and download URLs. At least 32 bytes of UTF-8 text in production (surrounding
# whitespace is trimmed). One of STORAGE_SIGNING_SECRET, S3_SIGNING_SECRET or OCI_SIGNING_SECRET is
# required in production; the first one set wins.
# Rule: secret, at least 32 bytes of UTF-8 text in production (the text is measured, never decoded), surrounding whitespace is trimmed.
STORAGE_SIGNING_SECRET=

# Alternative name of STORAGE_SIGNING_SECRET; used when STORAGE_SIGNING_SECRET is not set.
# Rule: secret, at least 32 bytes of UTF-8 text in production (the text is measured, never decoded), surrounding whitespace is trimmed.
# S3_SIGNING_SECRET=

# Alternative name of STORAGE_SIGNING_SECRET; used when neither STORAGE_SIGNING_SECRET nor
# S3_SIGNING_SECRET is set.
# Rule: secret, at least 32 bytes of UTF-8 text in production (the text is measured, never decoded), surrounding whitespace is trimmed.
# OCI_SIGNING_SECRET=

# Directory of the local storage driver and of the API key, usage and file stores. Share it between
# the API and the workers.
# Rule: file or directory path.
# Default: .easyconvert/storage under the working directory.
# EASYCONVERT_STORAGE_DIR=

# Seconds a conversion result is kept when nobody has downloaded it completely, counted from the
# moment it is stored; after that it is deleted and its download answers 410 Gone. The upload a job
# reads is deleted shortly after the last job that reads it ends (RESULT_DELIVERED_GRACE_SECONDS)
# and does not wait for this. Applies to every storage driver; a bucket lifecycle rule is only a
# backstop.
# Rule: integer, 60 to 86400.
# RESULT_UNDELIVERED_TTL_SECONDS=3600

# Seconds a conversion result stays downloadable after its first complete delivery (one response, or
# ranges that together cover the whole file), so a second click or a resumed download still works.
# After that it is deleted and its download answers 410 Gone. A download that stops early does not
# count as a delivery.
# Rule: integer, 1 to 3600.
# RESULT_DELIVERED_GRACE_SECONDS=600

# Disk use, in percent of the file system that holds EASYCONVERT_STORAGE_DIR, above which the sweep
# deletes results before their time: delivered results in their grace period first, the earliest
# delivery first, then undelivered results, the oldest first, until the use is at or below
# RESULT_DISK_LOW_PERCENT. A pass that deleted nothing, or whose deletions together did not lower
# the use, waits five minutes unless the use moved. The files of a queued or running job,
# undelivered results younger than ten minutes and partly downloaded results are never deleted. Such
# a result answers 410 Gone with the reason `capacity`. Local storage driver only; must be above
# RESULT_DISK_LOW_PERCENT and below RESULT_DISK_REFUSE_PERCENT.
# Rule: integer, 1 to 99.
# RESULT_DISK_HIGH_PERCENT=85

# Disk use, in percent, at or below which the early deletion that RESULT_DISK_HIGH_PERCENT starts
# stops again. Local storage driver only; must be below RESULT_DISK_HIGH_PERCENT.
# Rule: integer, 1 to 99.
# RESULT_DISK_LOW_PERCENT=80

# Disk use, in percent, above which new uploads and conversions answer 503 with Retry-After, after
# an early deletion of results did not bring the use down to it, measured on the fuller of the file
# system that holds EASYCONVERT_STORAGE_DIR and the temporary directory; the parts, completion and
# abort of a running upload go on. Local storage driver only; must be above RESULT_DISK_HIGH_PERCENT
# and at most 99.
# Rule: integer, 1 to 99.
# RESULT_DISK_REFUSE_PERCENT=95

# OCI Object Storage namespace (a single DNS label). Required when STORAGE_DRIVER is `oci`; checked
# when storage is selected.
# Rule: text.
# OCI_NAMESPACE=

# OCI region (lowercase letters, digits, hyphens). Required when STORAGE_DRIVER is `oci`; only the
# in-memory OCI emulation falls back to a region.
# Rule: text.
# Default: ap-seoul-1 (in-memory OCI emulation only).
# OCI_REGION=

# OCI bucket name. Required when STORAGE_DRIVER is `oci` (OCI_BUCKET_NAME is accepted instead); only
# the in-memory OCI emulation falls back to a bucket.
# Rule: text.
# Default: easyconvert-transcode-bucket (in-memory OCI emulation only).
# OCI_BUCKET=

# Alternative name of OCI_BUCKET; used when OCI_BUCKET is not set.
# Rule: text.
# OCI_BUCKET_NAME=

# Overrides the S3-compatible endpoint derived from the namespace and region (private endpoint, test
# server). https in production.
# Rule: URL with the scheme http or https, https only in production, no user info.
# OCI_ENDPOINT=

# Customer secret key id of the OCI S3-compatible API. Required when STORAGE_DRIVER is `oci`.
# Rule: secret text.
# OCI_ACCESS_KEY_ID=

# Customer secret key of the OCI S3-compatible API. Required when STORAGE_DRIVER is `oci`.
# Rule: secret text.
# OCI_SECRET_ACCESS_KEY=

# Endpoint of the S3-compatible service. Required when STORAGE_DRIVER is `s3`. https in production.
# Rule: URL with the scheme http or https, https only in production, no user info.
# S3_ENDPOINT=

# Region of the S3-compatible service (lowercase letters, digits, hyphens). Required when
# STORAGE_DRIVER is `s3`.
# Rule: text.
# S3_REGION=

# Bucket name. Required when STORAGE_DRIVER is `s3` (S3_BUCKET_NAME is accepted instead).
# Rule: text.
# S3_BUCKET=

# Alternative name of S3_BUCKET; used when S3_BUCKET is not set.
# Rule: text.
# S3_BUCKET_NAME=

# Access key id of the S3-compatible service. Required when STORAGE_DRIVER is `s3`.
# Rule: secret text.
# S3_ACCESS_KEY_ID=

# Secret access key of the S3-compatible service. Required when STORAGE_DRIVER is `s3`.
# Rule: secret text.
# S3_SECRET_ACCESS_KEY=

# Path-style bucket addressing. Set to `false` for virtual-hosted-style addressing.
# Rule: true or false.
# S3_FORCE_PATH_STYLE=true

# Deprecated fallback of OCI_ACCESS_KEY_ID and S3_ACCESS_KEY_ID; logs a warning when used.
# Rule: secret text.
# AWS_ACCESS_KEY_ID=

# Deprecated fallback of OCI_SECRET_ACCESS_KEY and S3_SECRET_ACCESS_KEY; logs a warning when used.
# Rule: secret text.
# AWS_SECRET_ACCESS_KEY=

# Deprecated fallback of OCI_REGION and S3_REGION; logs a warning when used.
# Rule: text.
# AWS_REGION=

# Deprecated fallback of OCI_BUCKET and S3_BUCKET; logs a warning when used.
# Rule: text.
# AWS_BUCKET_NAME=

# Comma-separated host:port list of WebDAV, Azure Blob, GCS and import/export URL endpoints that may
# be plain http or private-address, for a local test server. Honoured only when NODE_ENV is exactly
# `development`.
# Rule: text.
# BYOS_HTTP_DEV_ENDPOINT_ALLOWLIST=

# Comma-separated host[:port] list of customer S3 endpoints that may be plain http or
# private-address. Honoured only when NODE_ENV is exactly `development`.
# Rule: text.
# BYOS_S3_DEV_ENDPOINT_ALLOWLIST=

# --- Queue and Redis ---

# Redis connection URL (`redis://` or `rediss://`, may carry a password). With neither REDIS_URL nor
# REDIS_HOST set, the queue and stores run in memory (development only).
# Rule: URL with the scheme redis or rediss.
# REDIS_URL=

# Redis host, used when REDIS_URL is not set.
# Rule: text.
# REDIS_HOST=

# Redis port, used with REDIS_HOST.
# Rule: integer, 1 to 65535.
# REDIS_PORT=6379

# Set to `true` to run the queue worker inside the web process (single-node use).
# Rule: true or false.
# EASYCONVERT_WORKER_ENABLED=false

# --- Worker ---

# Jobs a worker runs at once.
# Rule: integer, 1 to 1024.
# WORKER_CONCURRENCY=3

# Jobs after which the worker drains and exits so the container manager restarts it. `0` turns
# recycling by job count off.
# Rule: integer, 0 to 2147483647.
# WORKER_MAX_JOBS=1000

# Resident memory in MiB above which the worker drains and exits after a job. `0` turns recycling by
# memory off.
# Rule: integer, 0 to 1048576.
# WORKER_MAX_RSS_MB=4096

# Milliseconds a draining worker waits for active jobs before it aborts them.
# Rule: integer, 0 to 2147483647.
# WORKER_DRAIN_TIMEOUT_MS=60000

# Milliseconds between heartbeat file updates.
# Rule: integer, 1 to 2147483647.
# WORKER_HEARTBEAT_INTERVAL_MS=5000

# File the worker writes its heartbeat to; the container health check reads it.
# Rule: file or directory path.
# Default: worker-heartbeat.json in the operating system temporary directory.
# WORKER_HEARTBEAT_FILE=

# Age in milliseconds after which the container health check (scripts/worker-healthcheck.js) calls
# the heartbeat stale.
# Rule: integer, 1 to 2147483647.
# WORKER_HEARTBEAT_MAX_STALE_MS=35000

# Set to `false` to skip the Redis connection check of the container health check.
# Rule: true or false.
# CHECK_REDIS=true

# Comma-separated queues this worker takes jobs from (`default`, `light`, `cpu`, `memory`, `gpu`).
# All queues when unset.
# Rule: text.
# WORKER_QUEUES=

# Milliseconds the LibreOffice pool waits for a worker process to become ready (5000 to 40000).
# Rule: integer, 5000 to 40000.
# LIBREOFFICE_POOL_READINESS_TIMEOUT_MS=30000

# Milliseconds a conversion that ignored its abort at the job deadline may stay unfinished before
# the worker drains and exits to be restarted (a processor that does not look at its signal cannot
# be stopped otherwise). The aborted conversion keeps its concurrency slot until it finishes.
# Rule: integer, 1 to 2147483647.
# JOB_STUCK_RECYCLE_MS=30000

# --- Limits ---

# Largest stored object, in bytes, that may be read into memory instead of streamed.
# Rule: integer, at least 1.
# MAX_IN_MEMORY_BYTES=536870912

# Largest body, in bytes, that an `import.url` graph node downloads.
# Rule: integer, at least 1.
# GRAPH_URL_IMPORT_MAX_BYTES=5368709120

# Largest declared canvas, in pixels, of a still-image input. A larger value is lowered to the
# built-in ceiling.
# Rule: integer, at least 1.
# EASYCONVERT_MAX_INPUT_PIXELS=100000000

# Threads the image pipeline leases per operation. When unset, non-encode operations use 1 thread
# and AVIF encodes and OCR page preparations lease up to 8 threads (2 when MALLOC_ARENA_MAX is
# unset).
# Rule: integer, 1 to 2147483647.
# Default: 1 outside an encode; up to 8 (2 when MALLOC_ARENA_MAX is unset) during an AVIF encode or OCR page preparation.
# VIPS_CONCURRENCY=

# Milliseconds the PDF text extraction may run before it is stopped.
# Rule: integer, 1 to 2147483647.
# EASYCONVERT_PDF_TEXT_DEADLINE_MS=60000

# Milliseconds of work the text recognition (OCR) of one page of a scanned PDF may cost. A document
# may take three page budgets plus one for each page it reads, so a long scan is never cut at a
# fixed time, and never more than 90 percent of the job's own deadline when it has one; a single
# page that takes six page budgets is refused too. A document or page over its limit is refused with
# HTTP 413.
# Rule: integer, 1 to 2147483647.
# EASYCONVERT_OCR_PAGE_BUDGET_MS=10000

# Most pages of one scanned PDF that text recognition (OCR) prepares and recognizes at once, capped
# at the built-in per-document ceiling of 4 and the OCR worker pool size.
# Rule: integer, 1 to 2147483647.
# EASYCONVERT_OCR_PAGE_CONCURRENCY=4

# Wall-clock milliseconds every conversion job of the free tier starts with, before the allowance
# for its media seconds and input size. A document does not use it: it gets the maximum of the tier.
# Must not exceed JOB_DEADLINE_MAX_MS_FREE.
# Rule: integer, 1 to 3600000.
# JOB_DEADLINE_BASE_MS_FREE=60000

# Wall-clock milliseconds every conversion job of the pro tier starts with, before the allowance for
# its media seconds and input size. A document does not use it: it gets the maximum of the tier.
# Must not exceed JOB_DEADLINE_MAX_MS_PRO.
# Rule: integer, 1 to 3600000.
# JOB_DEADLINE_BASE_MS_PRO=120000

# Wall-clock milliseconds every conversion job of the enterprise tier starts with, before the
# allowance for its media seconds and input size. A document does not use it: it gets the maximum of
# the tier. Must not exceed JOB_DEADLINE_MAX_MS_ENTERPRISE.
# Rule: integer, 1 to 3600000.
# JOB_DEADLINE_BASE_MS_ENTERPRISE=180000

# Most wall-clock milliseconds a conversion job of the free tier may run, the queue job timeout and
# the limit of the synchronous routes. A job past it is stopped, its processes are killed and it
# fails with JobTimeoutError (HTTP 504); work of unknown size, and a document (its pages are not
# known before it is converted), gets this value. At most one hour, since the sweep removes a job
# directory two hours after it was made.
# Rule: integer, 1 to 3600000.
# JOB_DEADLINE_MAX_MS_FREE=300000

# Most wall-clock milliseconds a conversion job of the pro tier may run, the queue job timeout and
# the limit of the synchronous routes. A job past it is stopped, its processes are killed and it
# fails with JobTimeoutError (HTTP 504); work of unknown size, and a document (its pages are not
# known before it is converted), gets this value. At most one hour, since the sweep removes a job
# directory two hours after it was made.
# Rule: integer, 1 to 3600000.
# JOB_DEADLINE_MAX_MS_PRO=1800000

# Most wall-clock milliseconds a conversion job of the enterprise tier may run, the queue job
# timeout and the limit of the synchronous routes. A job past it is stopped, its processes are
# killed and it fails with JobTimeoutError (HTTP 504); work of unknown size, and a document (its
# pages are not known before it is converted), gets this value. At most one hour, since the sweep
# removes a job directory two hours after it was made.
# Rule: integer, 1 to 3600000.
# JOB_DEADLINE_MAX_MS_ENTERPRISE=3600000

# Milliseconds added to a job deadline for each started MiB of input.
# Rule: integer, 1 to 2147483647.
# JOB_DEADLINE_PER_MIB_MS=2000

# Milliseconds added to a job deadline for each second of audio or video, when the length is known.
# Rule: integer, 1 to 2147483647.
# JOB_DEADLINE_PER_MEDIA_SECOND_MS=3000

# Most wall-clock milliseconds a synchronous conversion request (`/api/convert`, `/api/v1/convert`,
# `/api/convert/batch`) may run, held below the job deadline of the tier. A request past it is
# stopped and answered with 504 and a pointer to the asynchronous API (`POST /api/v1/jobs`), which
# runs conversions up to the job deadline.
# Rule: integer, 1 to 2147483647.
# SYNC_DEADLINE_MAX_MS=120000

# Most conversions an anonymous or free-tier caller may have in flight at once, queued and running
# together, counted on the server. A request that would exceed it is answered 429 (problem type
# `concurrency-limit`, with `Retry-After`) and takes no quota. Paid tiers have no such limit.
# Rule: integer, 1 to 2147483647.
# CONVERSION_CONCURRENCY_FREE=5

# Most cells (rows x columns of the used range) of a legacy XLS sheet that an HTML, ODS or XLSX
# conversion expands to a grid in memory; a larger sheet is refused with HTTP 413. CSV, TSV and JSON
# are written row by row and are not limited by it.
# Rule: integer, at least 1.
# EASYCONVERT_XLS_MAX_GRID_CELLS=4194304

# Most cells holding text of a legacy XLS sheet that the in-process PDF writer lays out as a table
# (about 3 KB of memory per cell); a sheet with more is refused with HTTP 413. Blank cells are not
# counted.
# Rule: integer, at least 1.
# EASYCONVERT_XLS_MAX_PDF_TEXT_CELLS=500000

# Most characters the cells of a legacy XLS sheet may expand to for an HTML, ODS, XLSX or PDF
# conversion, shared strings counted once per cell that uses them; a sheet over it is refused with
# HTTP 413 (protects against one long shared string used by many cells).
# Rule: integer, at least 1.
# EASYCONVERT_XLS_MAX_CELL_TEXT_CHARS=67108864

# Most characters the cells of an XLSX workbook may expand to, shared strings counted once per cell
# that uses them; a workbook over it is refused with HTTP 413 (protects against one long shared
# string used by many cells).
# Rule: integer, at least 1.
# EASYCONVERT_XLSX_MAX_CELL_TEXT_CHARS=67108864

# Most bytes of embedded media (pictures, video) one deck or document may decode to, each part
# counted once however many pictures use it; a document over it is refused with HTTP 413 (keeps the
# memory of a deck with large or repeated media within a job share).
# Rule: integer, at least 1.
# EASYCONVERT_MAX_DOCUMENT_MEDIA_BYTES=1073741824

# Conversions per day for an anonymous caller. In the OCI deployment it is the repository variable
# of the same name, which the web image build and the deploy both read (the deploy refuses an image
# built with another value).
# Rule: integer, 1 to 2147483647.
# ANONYMOUS_DAILY_LIMIT=10

# Token bucket size (largest burst of requests) of one anonymous caller.
# Rule: integer, 1 to 2147483647.
# ANONYMOUS_BURST_CAPACITY=10

# Requests per second that refill the token bucket of one anonymous caller.
# Rule: integer, 1 to 2147483647.
# ANONYMOUS_BURST_REFILL_RATE=1

# Token bucket size shared by every anonymous caller whose address cannot be trusted.
# Rule: integer, 1 to 2147483647.
# ANONYMOUS_UNATTRIBUTED_BURST_CAPACITY=600

# Requests per second that refill the bucket shared by untrusted anonymous callers.
# Rule: integer, 1 to 2147483647.
# ANONYMOUS_UNATTRIBUTED_BURST_REFILL_RATE=100

# --- Native tools ---

# Whether the qpdf jobs of the PDF operations run in a child of `qpdf-runner` (native/qpdf-runner)
# that has libqpdf loaded already, each in a user and network namespace of its own, instead of
# starting the `qpdf` program. `auto` (the default) uses the runner when it is installed and starts,
# and starts the program otherwise (and for any job the runner declines or cannot isolate). `off`
# always starts the program.
# Rule: one of auto, off (any case).
# QPDF_RUNNER=auto

# Whether Korean pages (`kor`, `kor+eng`) are read by the ONNX OCR engine (PP-OCRv5 models in a
# sandboxed helper process, `src/lib/conversions/ocr-onnx-helper.ts`). `auto` (the default) uses it
# when the models, the `onnxruntime-node` package and the helper program are present, and reads
# Korean with Tesseract otherwise (the result carries `engineFallback`). `off` always reads Korean
# with Tesseract.
# Rule: one of auto, off (any case).
# EASYCONVERT_OCR_ONNX=auto

# Path of the ffmpeg executable; searched in the standard locations when unset.
# Rule: path or command name of an executable (existence is not checked at start-up).
# FFMPEG_PATH=

# Path of the ffprobe executable.
# Rule: path or command name of an executable (existence is not checked at start-up).
# FFPROBE_PATH=

# Path of the FluidSynth `fluidsynth` executable that renders MIDI files to WAV; searched in the
# standard locations when unset.
# Rule: path or command name of an executable (existence is not checked at start-up).
# FLUIDSYNTH_PATH=

# Path of the General MIDI SoundFont (`.sf2` or `.sf3`) handed to FluidSynth; searched in the
# standard locations when unset.
# Rule: file or directory path.
# MIDI_SOUNDFONT_PATH=

# Absolute path of the libavif `avifenc` executable that encodes AVIF; searched in the standard
# locations when unset. The image library encodes when the tool is not installed, is not an
# executable file or is older than libavif 1.0.0; a value that is not an absolute path is rejected
# at start-up.
# Rule: absolute path of an executable (existence is not checked at start-up).
# AVIFENC_PATH=

# Absolute path of the ImageMagick executable (`magick`, or `convert` of version 6) that decodes
# HEIC, HEIF, PSD, XCF, TGA, PCX, DDS, PNM and old-style JPEG TIFF pictures; searched in the
# standard locations when unset. Those conversions fail with HTTP 503 when the tool is not installed
# or is not an executable file; a value that is not an absolute path is rejected at start-up.
# Rule: absolute path of an executable (existence is not checked at start-up).
# MAGICK_PATH=

# Absolute path of the OpenJPEG `opj_decompress` executable that decodes JPEG 2000 (JP2, J2K)
# pictures; searched in the standard locations when unset. Those conversions fail with HTTP 503 when
# the tool is not installed or is not an executable file; a value that is not an absolute path is
# rejected at start-up.
# Rule: absolute path of an executable (existence is not checked at start-up).
# OPJ_DECOMPRESS_PATH=

# Absolute path of the libjxl `djxl` executable that decodes JPEG XL (JXL) pictures; searched in the
# standard locations when unset. Those conversions fail with HTTP 503 when the tool is not installed
# or is not an executable file; a value that is not an absolute path is rejected at start-up.
# Rule: absolute path of an executable (existence is not checked at start-up).
# DJXL_PATH=

# Absolute path of the directory that holds the ImageMagick `policy.xml` every picture decode runs
# under (all coders and delegates denied except those the decoders use). Searched in
# `/etc/easyconvert/imagemagick` (the worker image) and `docker/imagemagick` (the repository) when
# unset; without a policy the conversions that need ImageMagick fail with HTTP 503.
# Rule: file or directory path.
# MAGICK_POLICY_DIR=

# Path of the 7-Zip executable (`7zz`, `7z` or `7za`).
# Rule: path or command name of an executable (existence is not checked at start-up).
# P7ZIP_PATH=

# Alternative name of P7ZIP_PATH for the archive code paths; used when P7ZIP_PATH is not set.
# Rule: path or command name of an executable (existence is not checked at start-up).
# P7Z_PATH=

# Path of the Info-ZIP `zip` executable.
# Rule: path or command name of an executable (existence is not checked at start-up).
# ZIP_PATH=

# Path of the `unrar` executable.
# Rule: path or command name of an executable (existence is not checked at start-up).
# UNRAR_PATH=

# Path of the `lbzip2` executable that compresses bzip2 streams of up to two blocks; searched in the
# standard locations when unset.
# Rule: path or command name of an executable (existence is not checked at start-up).
# LBZIP2_PATH=

# Path of the `libdeflate-gzip` executable that compresses raw deflate streams; searched in the
# standard locations when unset.
# Rule: path or command name of an executable (existence is not checked at start-up).
# LIBDEFLATE_GZIP_PATH=

# Path of the `xz` executable that compresses and decompresses XZ streams; searched in the standard
# locations when unset.
# Rule: path or command name of an executable (existence is not checked at start-up).
# XZ_PATH=

# Path of the LibreOffice `soffice` executable.
# Rule: path or command name of an executable (existence is not checked at start-up).
# SOFFICE_PATH=

# Path of the poppler `pdfinfo` executable.
# Rule: path or command name of an executable (existence is not checked at start-up).
# PDFINFO_PATH=

# Path of the poppler `pdftoppm` executable.
# Rule: path or command name of an executable (existence is not checked at start-up).
# PDFTOPPM_PATH=

# Path of the poppler `pdftocairo` executable.
# Rule: path or command name of an executable (existence is not checked at start-up).
# PDFTOCAIRO_PATH=

# Path of the poppler `pdftotext` executable.
# Rule: path or command name of an executable (existence is not checked at start-up).
# PDFTOTEXT_PATH=

# Path of the poppler `pdftops` executable.
# Rule: path or command name of an executable (existence is not checked at start-up).
# PDFTOPS_PATH=

# Path of the Ghostscript `ps2pdf` executable.
# Rule: path or command name of an executable (existence is not checked at start-up).
# PS2PDF_PATH=

# Path of the GhostXPS `gxps` executable that draws an XPS or OpenXPS document as a PDF; searched in
# the standard locations when unset. XPS to PDF and to page images cannot be converted without it
# (HTTP 503).
# Rule: path or command name of an executable (existence is not checked at start-up).
# GXPS_PATH=

# Path of the djvulibre `ddjvu` executable that draws a DjVu document as a PDF; searched in the
# standard locations when unset. DjVu to PDF and to page images cannot be converted without it (HTTP
# 503).
# Rule: path or command name of an executable (existence is not checked at start-up).
# DDJVU_PATH=

# Path of the Ghostscript `gs` executable that the PDF optimize operation runs.
# Rule: path or command name of an executable (existence is not checked at start-up).
# GS_PATH=

# Path of the LibRaw `dcraw_emu` executable.
# Rule: path or command name of an executable (existence is not checked at start-up).
# DCRAW_EMU_PATH=

# Path of the `dcraw_emu` of the pinned LibRaw snapshot (scripts/install-libraw-he.sh) that reads
# Nikon NEF files with High Efficiency or High Efficiency* compression; searched in the standard
# locations when unset. Without it such a file is refused with the words of the `dcraw_emu` of
# `DCRAW_EMU_PATH`; every other camera file never uses it.
# Rule: path or command name of an executable (existence is not checked at start-up).
# DCRAW_EMU_HE_PATH=

# Absolute path of the calibre `ebook-convert` executable that writes MOBI, AZW3, PDB, LRF and OEB
# books; searched in the standard locations when unset. Those five formats cannot be written without
# it (HTTP 503); a value that is not an absolute path is rejected at start-up.
# Rule: absolute path of an executable (existence is not checked at start-up).
# EBOOK_CONVERT_PATH=

# Path of the LibreDWG `dwg2dxf` executable that reads a DWG drawing into a DXF; searched in the
# standard locations when unset. A DWG cannot be converted without it (HTTP 503).
# Rule: path or command name of an executable (existence is not checked at start-up).
# DWG2DXF_PATH=

# Path of the vtracer executable that traces PNG, JPEG, WebP, GIF, BMP and TIFF pictures to SVG;
# searched in the standard locations when unset. Those pictures cannot be converted to SVG without
# it (HTTP 503).
# Rule: path or command name of an executable (existence is not checked at start-up).
# VTRACER_PATH=

# Path of the pinned oxipng executable that optimises a PNG converted to PNG without loss (entry
# 232); searched in the standard locations when unset. Without it the PNG is written as the image
# library encodes it.
# Rule: path or command name of an executable (existence is not checked at start-up).
# OXIPNG_PATH=

# Path of the vtracer-pixels executable (scripts/vtracer-pixels), the vtracer front-end that reads
# the raw pixels the worker decoded; searched in the standard locations when unset. When it is found
# it traces those pictures instead of the vtracer executable; the SVG is the same.
# Rule: path or command name of an executable (existence is not checked at start-up).
# VTRACER_PIXELS_PATH=

# Path of the `cad-convert` executable (native/cad-convert, linked to the Open CASCADE libraries)
# that reads and writes STEP and IGES; searched in the standard locations when unset. A STEP or IGES
# file cannot be converted without it (HTTP 503).
# Rule: path or command name of an executable (existence is not checked at start-up).
# CAD_CONVERT_PATH=

# Path of the `pid-init` executable (native/pid-init) that starts every sandboxed program in a PID
# namespace of its own, so that one run cannot see or signal another, and refuses them the /proc
# entries of the other runs (Landlock); searched in the standard locations when unset. Without it,
# or when the host does not allow a PID namespace, programs run in the user and network namespaces
# only.
# Rule: path or command name of an executable (existence is not checked at start-up).
# PID_INIT_PATH=

# Path of the `qpdf-runner` executable (native/qpdf-runner) that runs the qpdf jobs of the PDF
# operations from a process that holds libqpdf already loaded; searched in the standard locations
# when unset. Without it, or when it cannot start a job, every job runs the `qpdf` program as
# before.
# Rule: path or command name of an executable (existence is not checked at start-up).
# QPDF_RUNNER_PATH=

# Path of the libqpdf shared library handed to `qpdf-runner` (`--lib`); the runner loads the system
# libqpdf when unset.
# Rule: file or directory path.
# QPDF_RUNNER_LIB=

# Path of the FontForge `fontforge` executable (fontforge-nox) that reads PostScript Type 1 fonts
# (PFA and PFB); searched in the standard locations when unset. A Type 1 font cannot be converted
# without it (HTTP 503).
# Rule: path or command name of an executable (existence is not checked at start-up).
# FONTFORGE_PATH=

# Path of the librsvg `rsvg-convert` executable that writes an SVG as a vector PDF.
# Rule: path or command name of an executable (existence is not checked at start-up).
# RSVG_CONVERT_PATH=

# Path of the `tesseract` executable.
# Rule: path or command name of an executable (existence is not checked at start-up).
# TESSERACT_PATH=

# Directory of the Tesseract language data.
# Rule: file or directory path.
# TESSDATA_PREFIX=

# Directory of the ONNX Korean OCR models (`det.onnx`, `rec.onnx`, `dict.txt`); `/opt/ocr-onnx` (the
# worker image) when unset. Installed by `scripts/install-onnx-ocr-models.sh`.
# Rule: file or directory path.
# EASYCONVERT_OCR_ONNX_DIR=

# Path of the `verapdf` executable that validates PDF/A output.
# Rule: path or command name of an executable (existence is not checked at start-up).
# VERAPDF_PATH=

# Path of the `qpdf` executable that encrypts PDF output.
# Rule: path or command name of an executable (existence is not checked at start-up).
# QPDF_PATH=

# Path of the fontconfig `fc-list` executable.
# Rule: path or command name of an executable (existence is not checked at start-up).
# FC_LIST_PATH=

# Java installation handed to LibreOffice for PDF/A export.
# Rule: file or directory path.
# JAVA_HOME=
