{
  "name": "@easyconvert/sdk",
  "version": "2.0.0",
  "description": "Official type-safe TypeScript/JavaScript client SDK for the EasyConvert platform.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/generated','dist/generated',{recursive:true})\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "easyconvert",
    "conversion",
    "pdf",
    "cad",
    "media",
    "sdk",
    "api"
  ],
  "author": "EasyConvert Engineering",
  "license": "MIT",
  "dependencies": {
    "openapi-fetch": "0.17.0"
  }
}
