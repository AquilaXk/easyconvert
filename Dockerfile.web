# EasyConvert OCI Web Server (Next.js), linux/arm64 (OCI Ampere A1) and linux/amd64
#
# The web process converts in process when WEB_EXECUTION_MODE is unset (hybrid), and so this image carries every engine the worker has; the
# production stack runs it queue-only (docker-compose.prod.yml), where the engines serve only the deploy smoke and the archive listing. This
# image is therefore the worker image plus the Next.js build: it adds one layer (.next, public and next.config.mjs) to the worker image it is
# built on, shares every other layer with it on disk and in the registry, and starts the server instead of the worker. Build the worker
# image first (Dockerfile.worker) and pass its digest as WORKER_IMAGE (the package is private: run `docker login ghcr.io` first, as the
# build job does with the workflow token):
#
#   docker build -f Dockerfile.web --build-arg WORKER_IMAGE=ghcr.io/<owner>/easyconvert-worker@sha256:<digest> \
#     --build-arg APP_ORIGIN=https://<public host> .
#
# Next.js standalone output is not used: next.config.mjs turns output file tracing off, and the worker image already carries the
# production node_modules (with the libvips build the worker pins), which `next start` reads.

# Same pinned base as Dockerfile.worker (tests/web-image.test.ts fails when the two differ).
ARG NODE_IMAGE=node:24.20.0-trixie-slim@sha256:50c3b2f6988dfc307b86e5301d69611af31f4789bdf232863b07d3b02fe55ae0
ARG WORKER_IMAGE=${NODE_IMAGE}

# ==============================================================================
# Stage 1: Next.js build
# ==============================================================================
FROM ${NODE_IMAGE} AS webbuilder

ENV DEBIAN_FRONTEND=noninteractive
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

WORKDIR /app

COPY package*.json ./

# Dependencies with the build tools (Tailwind, TypeScript), ignoring lifecycle scripts for supply-chain security
RUN npm ci --include=dev --ignore-scripts

COPY tsconfig.json next.config.mjs postcss.config.mjs tailwind.config.ts ./
COPY messages/ ./messages/
COPY public/ ./public/
COPY src/ ./src/
# The legal pages are built from these Markdown files (src/lib/legal/texts.ts).
COPY docs/legal/ ./docs/legal/

# The public origin (https://<host>) the build writes into the file it prerenders, robots.txt: search engines read its sitemap URL
# as an absolute one, so the build fails without it. Pages and sitemap.xml render per request (policy entries 370 and 443) and take
# the origin from the server's environment (scripts/boot-web-image.sh checks the pages against it).
ARG APP_ORIGIN
ENV APP_ORIGIN=${APP_ORIGIN}
RUN test -n "$APP_ORIGIN" || { echo 'APP_ORIGIN must be set: pass --build-arg APP_ORIGIN=https://<public host>' >&2; exit 1; }

# The commit the build is made from: a crash report of a page names it (policy entry 384). The build writes it into the scripts of the
# page, so it is no secret; a build without it (a local one) leaves it out of the report.
ARG RELEASE_SHA=
ENV NEXT_PUBLIC_RELEASE_SHA=${RELEASE_SHA}

# `next build` has no runtime environment: the production requirements of the configuration are enforced at start-up, not here
# (NEXT_PHASE=phase-production-build).
RUN ./node_modules/.bin/next build

# ==============================================================================
# Optional Target: Stateless control-plane Web runtime (`--target webslim`)
# Pure Node.js + Next.js without native conversion engines for multi-replica
# clusters running with `WEB_EXECUTION_MODE=queue-only`.
# ==============================================================================
FROM ${NODE_IMAGE} AS webslim

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV WEB_EXECUTION_MODE=queue-only
ENV EASYCONVERT_STORAGE_DIR=/tmp/easyconvert-storage

WORKDIR /app

COPY package*.json ./
RUN groupadd -g 10001 -r easyconvert \
    && useradd -u 10001 -r -g easyconvert -m -d /home/easyconvert -s /sbin/nologin easyconvert \
    && mkdir -p /tmp/easyconvert-storage /shared/storage \
    && npm ci --omit=dev --ignore-scripts \
    && npm cache clean --force \
    && chown -R easyconvert:easyconvert /app /tmp/easyconvert-storage /shared/storage
COPY --from=webbuilder --chown=easyconvert:easyconvert /app/.next ./.next
COPY --from=webbuilder --chown=easyconvert:easyconvert /app/public ./public
COPY --chown=easyconvert:easyconvert next.config.mjs ./next.config.mjs

USER easyconvert:easyconvert
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD node -e "fetch('http://127.0.0.1:3000/api/health/live').then((r)=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

CMD ["node", "node_modules/next/dist/bin/next", "start", "--hostname", "0.0.0.0", "--port", "3000"]

# ==============================================================================
# Stage 2: Web runtime on the worker image (default target)
# ==============================================================================
FROM ${WORKER_IMAGE} AS web

# The worker image this one is built on (an OCI image-spec annotation key), which deploy/oci/deploy.sh compares with the worker image
# it pins, so that a web and a worker image of two different builds are never started together.
ARG WORKER_IMAGE
LABEL org.opencontainers.image.base.name="${WORKER_IMAGE}"
# The smoke probe the server answers (src/app/api/health/conversion), which deploy/oci/deploy.sh reads from each release it starts.
# An image without it gets the smoke through /api/convert that it was built for.
LABEL easyconvert.smoke-probe="/api/health/conversion"

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

COPY --from=webbuilder --chown=easyconvert:easyconvert /app/.next ./.next
COPY --from=webbuilder --chown=easyconvert:easyconvert /app/public ./public
COPY --chown=easyconvert:easyconvert next.config.mjs ./next.config.mjs

EXPOSE 3000

# Liveness, not readiness: the container is unhealthy only when the process stops serving. A Redis or storage outage is /api/health's
# to report, and deploy/oci/deploy.sh still waits for that answer before it calls a release started.
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl --fail --silent --show-error --max-time 8 http://127.0.0.1:3000/api/health/live > /dev/null || exit 1

# Process init wrapper (tini) is the inherited ENTRYPOINT. The server runs as the unprivileged user of the worker image.
CMD ["node", "node_modules/next/dist/bin/next", "start", "--hostname", "0.0.0.0", "--port", "3000"]
