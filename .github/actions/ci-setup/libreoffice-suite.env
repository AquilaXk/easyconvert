# The office suite that a CI job installs when it asks for it (the `libreoffice` input of the ci-setup action): the release of the version the worker
# image ships (docs/policy-decisions.md, entry 383), from the permanent release archive of the project, not the mirror of the current stable line,
# which drops a version when the next one is out. This file is also the key of the cache of the install. Bump the version, the URL and the digest
# together when the pin of Dockerfile.worker moves.
LIBREOFFICE_VERSION=26.8.2.2
LIBREOFFICE_URL=https://downloadarchive.documentfoundation.org/libreoffice/old/26.8.2.2/deb/x86_64/LibreOffice_26.8.2.2_Linux_x86-64_deb.tar.gz
LIBREOFFICE_SHA256=8290c8f46cb33d6df8f681cb796e0697461ea070f86ec55b63c94d7eb9d9a476
