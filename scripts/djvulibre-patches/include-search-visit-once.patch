+GP<DjVuInfo>
+DjVuImage::get_info(const GP<DjVuFile> & file) const
+{
+   GMap<GURL, void *> map;
+   GP<DjVuInfo> info=find_component(file, &DjVuFile::info, map);
+   if (info && rotate_count<0)
+     const_cast<DjVuImage *>(this)->init_rotate(*info);
+   return info;
