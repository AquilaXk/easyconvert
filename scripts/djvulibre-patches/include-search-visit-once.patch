libdjvu/DjVuImage: search the included files once each for a page component

DjVuImage::get_info(), get_bg44(), get_bgpm(), get_fgjb(), get_fgpm() and
get_fgbc() look for a component in the file of the page and then, depth first,
in the files it includes. A shared file included through several paths is
searched once for each path, so a chain of shared files that each include the
next two costs a number of visits that grows like the Fibonacci numbers: 40
such files take 50 s to draw one empty page, though each file is created and
decoded only once.

Search the graph as DjVuFile::get_merged_anno() walks it, with a map of the
URLs already visited, so that each file is searched once. The first file
found in depth-first order is the one the recursive search found: a file is
skipped only when an earlier visit searched it and everything it includes
without finding the component. get_info() calls init_rotate() on the
information it finds, as before; its second call on the caller's own (empty)
information is gone, which never ran, as the first call leaves rotate_count at
an orientation from 0 to 3.

--- a/libdjvu/DjVuImage.cpp
+++ b/libdjvu/DjVuImage.cpp
@@ -106,104 +106,72 @@
 
 //// DJVUIMAGE: DATA COLLECTORS
 
-GP<DjVuInfo>
-DjVuImage::get_info(const GP<DjVuFile> & file) const
+// A shared file may be included through several paths.  As in
+// DjVuFile::get_merged_anno(), each file is searched once, so that the
+// search costs one visit per file and not one per path.
+template <class TYPE> static GP<TYPE>
+find_component(const GP<DjVuFile> & file, GP<TYPE> DjVuFile::* component,
+               GMap<GURL, void *> & map)
 {
-   if (file->info)
-   {
-     if(rotate_count<0)
-     {
-       const_cast<DjVuImage *>(this)->init_rotate(*(file->info));
-     }
-     return file->info;
-   }
+   GURL url=file->get_url();
+   if (map.contains(url))
+     return 0;
+   map[url]=0;
+   if (file->*component)
+     return file->*component;
    GPList<DjVuFile> list=file->get_included_files();
    for(GPosition pos=list;pos;++pos)
    {
-      GP<DjVuInfo> info=get_info(list[pos]);
-      if (info) 
-      {
-        if(rotate_count<0)
-        {
-          const_cast<DjVuImage *>(this)->init_rotate(*(file->info));
-        }
-        return info;
-      }
+      GP<TYPE> found=find_component(list[pos], component, map);
+      if (found)
+        return found;
    }
    return 0;
 }
 
+GP<DjVuInfo>
+DjVuImage::get_info(const GP<DjVuFile> & file) const
+{
+   GMap<GURL, void *> map;
+   GP<DjVuInfo> info=find_component(file, &DjVuFile::info, map);
+   if (info && rotate_count<0)
+     const_cast<DjVuImage *>(this)->init_rotate(*info);
+   return info;
+}
+
