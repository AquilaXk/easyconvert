+/* Give libvorbis the `samples` samples held in the chunk buffer and collect the packets they complete. */
+static int libvorbis_write_chunk(AVCodecContext *avctx, int samples)
+{
+    LibvorbisEncContext *s = avctx->priv_data;
+    int channels = s->vi.channels;
+    float **buffer;
+    int ret;
+
+    buffer = vorbis_analysis_buffer(&s->vd, samples);
+    for (int c = 0; c < channels; c++)
+        memcpy(buffer[c], s->chunk + c * LIBVORBIS_CHUNK_SIZE,
+               samples * sizeof(*buffer[c]));
+    if ((ret = vorbis_analysis_wrote(&s->vd, samples)) < 0) {
+        av_log(avctx, AV_LOG_ERROR, "error in vorbis_analysis_wrote()\n");
+        return vorbis_error_to_averror(ret);
+    }
 
+    return libvorbis_collect_packets(avctx);
+}
+
+/* Hand the samples of a frame, or the end of the stream, to libvorbis. */
+static int libvorbis_send_frame(AVCodecContext *avctx, const AVFrame *frame)
+{
+    LibvorbisEncContext *s = avctx->priv_data;
+    int channels = s->vi.channels;
+    int ret;
+
+    if (frame) {
+        if ((ret = ff_af_queue_add(&s->afq, frame)) < 0)
+            return ret;
+
+        for (int pos = 0; pos < frame->nb_samples;) {
+            int n = FFMIN(frame->nb_samples - pos,
+                          LIBVORBIS_CHUNK_SIZE - s->chunk_samples);
+
+            for (int c = 0; c < channels; c++) {
+                int co = (channels > 8) ? c :
+                         vorbis_encoding_channel_layout_offsets[channels - 1][c];
+                memcpy(s->chunk + c * LIBVORBIS_CHUNK_SIZE + s->chunk_samples,
+                       (const float *)frame->extended_data[co] + pos,
+                       n * sizeof(*s->chunk));
+            }
+            s->chunk_samples += n;
+            pos              += n;
+            if (s->chunk_samples == LIBVORBIS_CHUNK_SIZE) {
+                s->chunk_samples = 0;
+                if ((ret = libvorbis_write_chunk(avctx, LIBVORBIS_CHUNK_SIZE)) < 0)
+                    return ret;
+            }
+        }
+    } else {
+        if (s->chunk_samples) {
+            int n = s->chunk_samples;
+
+            s->chunk_samples = 0;
+            if ((ret = libvorbis_write_chunk(avctx, n)) < 0)
+                return ret;
+        }
+        if (!s->eof && s->afq.frame_alloc)
+            if ((ret = vorbis_analysis_wrote(&s->vd, 0)) < 0) {
+                av_log(avctx, AV_LOG_ERROR, "error in vorbis_analysis_wrote()\n");
+                return vorbis_error_to_averror(ret);
+            }
+        s->eof = 1;
+        return libvorbis_collect_packets(avctx);
+    }
+
+    return 0;
+}
