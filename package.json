{
  "name": "easyconvert",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:raw-worker",
    "start": "next start",
    "lint": "next lint",
    "guard:anti-cheat": "tsx scripts/guard-anti-cheat.ts",
    "fixtures:raw": "node scripts/fetch-raw-fixtures.mjs",
    "pretest": "npm run guard:anti-cheat",
    "test": "vitest run",
    "test:redis": "vitest run tests/job-lifecycle-redis.test.ts && vitest run tests/job-graph-redis-e2e.test.ts && vitest run tests/phase-1-queue-sandbox-lifecycle.test.ts -t \"pops waiting jobs|schedules delayed jobs\"",
    "bench:zstd": "PERF_BENCH=1 vitest run tests/zstd-streaming-dict.test.ts",
    "worker": "tsx src/worker/index.ts",
    "build:worker": "esbuild src/worker/index.ts --bundle --platform=node --target=node20 --outfile=dist/worker.js --packages=external && npm run build:raw-worker",
    "generate:corpus": "tsx scripts/generate-golden-corpus.ts",
    "generate:sdk": "tsx scripts/generate-sdk.ts",
    "build:raw-worker": "esbuild src/worker/raw-decode-worker.ts --bundle --platform=node --target=node20 --outfile=dist/raw-decode-worker.js --packages=external"
  },
  "dependencies": {
    "@types/ioredis": "^4.28.10",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "clsx": "^2.1.1",
    "iconv-lite": "^0.7.3",
    "ioredis": "^6.0.0",
    "js-yaml": "^4.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.454.0",
    "next": "^15.5.27",
    "papaparse": "^5.4.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pdfkit": "^0.15.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^2.5.4",
    "tesseract.js": "^7.0.0",
    "undici": "^6.29.0"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "^2.11.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.17.0",
    "@types/papaparse": "^5.3.14",
    "@types/pdfkit": "^0.13.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  }
}
