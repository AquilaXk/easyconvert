# EasyConvert OCI Backend Container Worker
# Enterprise Multi-Stage Build: linux/arm64 (OCI Ampere A1), linux/amd64

# Base of every stage: Node.js 24 (active LTS) on Debian 13 (trixie). The exact release tag and the digest of its
# multi-architecture index are pinned together, so a rebuild cannot pick up a different base. Bump both together to take
# a newer Node.js 24 release or a rebuilt base (docs/policy-decisions.md, "Base image and Node.js LTS").
ARG NODE_IMAGE=node:24.20.0-trixie-slim@sha256:50c3b2f6988dfc307b86e5301d69611af31f4789bdf232863b07d3b02fe55ae0

# ==============================================================================
# Stage 1: Dependency & Application Builder
# ==============================================================================
FROM ${NODE_IMAGE} AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV NODE_ENV=production

WORKDIR /app

# Copy dependency manifests
COPY package*.json ./

# Install dependencies (ignoring lifecycle scripts for supply-chain security)
RUN npm ci --include=dev --ignore-scripts

# Copy configuration and source files
COPY tsconfig.json ./
COPY src/ ./src/

# Compile worker bundle to dist/worker.js
RUN npm run build:worker

# Prune devDependencies to ship production dependencies only
RUN npm prune --omit=dev --ignore-scripts

# ==============================================================================
# Stage 2: Pinned 7-Zip console build
# ==============================================================================
# The maintained upstream 7-Zip, not the legacy p7zip packages. Debian ships 7-Zip as the `7zip` package without the
# RAR decoder (it is the separate non-free `7zip-rar` package), so RAR input uses the upstream build. The final grep
# fails the build if the RAR decoder is ever missing. Each archive is pinned by SHA-256: bump SEVEN_ZIP_VERSION,
# SEVEN_ZIP_RELEASE and both digests together.
FROM ${NODE_IMAGE} AS sevenzip

ARG SEVEN_ZIP_VERSION=26.01
ARG SEVEN_ZIP_RELEASE=2601
ARG SEVEN_ZIP_SHA256_X64=8ea0fc8a135e7b848e80a4116fe22dff56c8c4518dde1f43cce67f4e340b437a
ARG SEVEN_ZIP_SHA256_ARM64=39f8c9070c300a63c7484d9a983119ef3edf841e1ddf69f1affae29fdec5f612

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl xz-utils \
    && case "$(dpkg --print-architecture)" in \
        amd64) SEVEN_ZIP_ARCH=x64; SEVEN_ZIP_SHA256="${SEVEN_ZIP_SHA256_X64}" ;; \
        arm64) SEVEN_ZIP_ARCH=arm64; SEVEN_ZIP_SHA256="${SEVEN_ZIP_SHA256_ARM64}" ;; \
        *) echo "No pinned 7-Zip build for $(dpkg --print-architecture)" >&2; exit 1 ;; \
    esac \
    && curl --proto '=https' --tlsv1.2 --fail --silent --show-error --location --retry 3 \
        --output /tmp/7zip.tar.xz \
        "https://github.com/ip7z/7zip/releases/download/${SEVEN_ZIP_VERSION}/7z${SEVEN_ZIP_RELEASE}-linux-${SEVEN_ZIP_ARCH}.tar.xz" \
    && echo "${SEVEN_ZIP_SHA256}  /tmp/7zip.tar.xz" | sha256sum --check --strict - \
    && mkdir /seven-zip \
    && tar -xJf /tmp/7zip.tar.xz -C /seven-zip 7zzs License.txt \
    && /seven-zip/7zzs i > /tmp/7zip-formats.txt \
    && grep -q ' Rar5 ' /tmp/7zip-formats.txt

# ==============================================================================
# Stage 3: Pinned LibreDWG reader (dwg2dxf)
# ==============================================================================
# The DWG to DXF step of DWG input. LibreDWG is GPL-3.0-or-later and is built here from its unmodified release archive,
# pinned by SHA-256 in scripts/install-libredwg.sh, as a statically linked program that the worker runs as a separate
# sandboxed process; nothing links it into the application. Debian ships no package of it. The stage fails the build if
# the program does not start.
FROM ${NODE_IMAGE} AS libredwg

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl xz-utils build-essential \
    && rm -rf /var/lib/apt/lists/*
COPY scripts/install-libredwg.sh /tmp/install-libredwg.sh
RUN /tmp/install-libredwg.sh /opt/libredwg

# ==============================================================================
# Stage 3b: Pinned GhostXPS renderer (gxps)
# ==============================================================================
# XPS and OpenXPS input. GhostXPS is part of GhostPDL (AGPL-3.0-or-later) and is built here from the unmodified release archive,
# pinned by SHA-256 in scripts/install-ghostxps.sh, with the copies of its libraries that ship in that archive, so the program needs
# only the C library; the worker runs it as a separate sandboxed process and nothing links it into the application. Debian ships
# no package of it. The stage fails the build if the program does not start.
FROM ${NODE_IMAGE} AS ghostxps

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl xz-utils build-essential \
    && rm -rf /var/lib/apt/lists/*
COPY scripts/install-ghostxps.sh /tmp/install-ghostxps.sh
RUN /tmp/install-ghostxps.sh /opt/ghostxps

# ==============================================================================
# Stage 3c: Pinned FFmpeg (ffmpeg, ffprobe)
# ==============================================================================
# Every audio and video conversion. FFmpeg is built here from its release archive and one patch (scripts/ffmpeg-patches), both
# pinned by SHA-256 in scripts/install-ffmpeg.sh, against the codec libraries of this Debian release (the development packages named
# below; the runtime stage installs the same libraries). Debian 13 ships FFmpeg 7.1, which decodes only part of an xHE-AAC stream,
# and trixie-backports holds no newer one. The build is GPL-2.0-or-later (libx264 and libx265) with no nonfree component, and the worker runs it as a
# separate sandboxed process; nothing links it into the application. The stage fails the build if a hardening property, a codec or
# a filter the conversions name is missing.
FROM ${NODE_IMAGE} AS ffmpeg

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        xz-utils \
        build-essential \
        patch \
        nasm \
        pkg-config \
        libx264-dev \
        libx265-dev \
        libvpx-dev \
        libsvtav1enc-dev \
        libdav1d-dev \
        libopus-dev \
        libmp3lame-dev \
        libvorbis-dev \
        libtheora-dev \
        libwebp-dev \
        libsoxr-dev \
        libzimg-dev \
        libass-dev \
        libva-dev \
        libdrm-dev \
        libffmpeg-nvenc-dev \
        zlib1g-dev \
        libbz2-dev \
        liblzma-dev \
    && rm -rf /var/lib/apt/lists/*
COPY scripts/install-ffmpeg.sh /tmp/install-ffmpeg.sh
COPY scripts/ffmpeg-patches /tmp/ffmpeg-patches
RUN /tmp/install-ffmpeg.sh /opt/ffmpeg

# ==============================================================================
# Stage 3d: Pinned libeot decompressor (eot2ttf)
# ==============================================================================
# EOT fonts compressed with MicroType Express. libeot is MPL-2.0 (its LZCOMP files are Monotype's code under the MTX licence) and is built
# here from the unmodified source at the commit pinned in scripts/install-libeot.sh, as a statically linked program that the worker runs
# as a separate sandboxed process; nothing links it into the application. The Debian package (libeot0 and eot2ttf 0.01-5) is not used:
# that release writes six composite glyphs of each corpus font with misplaced instruction bytes. The stage fails the build if the program
# does not start.
FROM ${NODE_IMAGE} AS libeot

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git build-essential \
    && rm -rf /var/lib/apt/lists/*
COPY scripts/install-libeot.sh /tmp/install-libeot.sh
RUN /tmp/install-libeot.sh /opt/libeot

# ==============================================================================
# Stage 4: Open CASCADE program (cad-convert)
# ==============================================================================
# STEP and IGES input and output. native/cad-convert is our own small program, built here against the unmodified Open CASCADE
# libraries of Debian (LGPL-2.1 with the exception) and linked to them dynamically; the worker runs it as a separate sandboxed process.
# The runtime stage installs only the libraries it needs and copies the binary. The stage fails the build if the program does not link.
FROM ${NODE_IMAGE} AS cadconvert

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        g++ \
        libocct-data-exchange-dev \
        libocct-ocaf-dev \
        libocct-modeling-algorithms-dev \
        libocct-modeling-data-dev \
        libocct-foundation-dev \
    && rm -rf /var/lib/apt/lists/*
COPY native/cad-convert/ /src/cad-convert/
RUN /src/cad-convert/build.sh /usr/local/bin/cad-convert

# ==============================================================================
# Stage 4b: qpdf job runner (qpdf-runner)
# ==============================================================================
# native/qpdf-runner is our own small C program (about 900 lines): it opens libqpdf of the runtime image with dlopen and runs each qpdf job
# of the PDF operations in a forked child, each in a user and network namespace of its own, instead of starting the qpdf program (1.26 ms of
# the 2.14 ms of an extraction are the start of qpdf). Nothing of qpdf is linked in, so it builds with a C compiler only. The worker falls
# back to the qpdf program for any job the runner declines, and when the runner is not there.
FROM ${NODE_IMAGE} AS qpdfrunner

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/*
COPY native/qpdf-runner/ /src/qpdf-runner/
RUN /src/qpdf-runner/build.sh /usr/local/bin/qpdf-runner

# ==============================================================================
# Stage 4c: sharp's libvips (libvips-cpp.so) with the codecs built for speed
# ==============================================================================
# sharp loads libvips from its @img/sharp-libvips-linux-<arch> package, which the upstream sharp-libvips release builds with
# libwebp, mozjpeg and libpng at -Os. This stage runs that release's own build, at its commit and in its own build container
# (Rocky Linux 8, pinned here by the digest of its multi-architecture index), with those three at -O3: the outputs are
# byte-identical and WebP and JPEG encodes are 6 to 31% faster (docs/policy-decisions.md, entry 84). On x64 only, aom is
# built as a Release at -O3 instead of MinSizeRel at -Os (entry 121). The scripts, the patches
# and the pins are in docker/sharp-libvips/. Every source the build script downloads with curl is pinned by SHA-256 and the
# toolchain downloads by digest or version, Meson may use only the subprojects its tarballs unpack, and git answers only local
# queries; the entry says what that does not cover. The runtime stage takes only libvips-cpp.so and its digest file from this stage, and
# fails the build unless sharp loads that file and is still the release it was built for.
FROM rockylinux/rockylinux:8-ubi-init@sha256:ae0813ccb1bb83f4e0220acdd1539f52831517de334368e960824db7e37ee210 AS sharplibvips-build

COPY docker/sharp-libvips/env.sh docker/sharp-libvips/toolchain.sh docker/sharp-libvips/requirements.txt /src/sharp-libvips/
RUN bash /src/sharp-libvips/toolchain.sh
COPY docker/sharp-libvips/build.sh docker/sharp-libvips/fetch-pinned.sh docker/sharp-libvips/git-local-only.sh docker/sharp-libvips/sources.sha256 docker/sharp-libvips/option-f.patch docker/sharp-libvips/aom-release-x64.patch docker/sharp-libvips/pinned-notices.patch docker/sharp-libvips/webp-thread-level.patch docker/sharp-libvips/libvips-webp-thread-level.patch docker/sharp-libvips/heif-auto-tiles.patch docker/sharp-libvips/libvips-heif-auto-tiles.patch /src/sharp-libvips/
RUN bash /src/sharp-libvips/build.sh /out

FROM scratch AS sharplibvips
COPY --from=sharplibvips-build /out/ /

# ==============================================================================
# Stage 5: Hardened Runtime Container
# ==============================================================================
FROM ${NODE_IMAGE} AS runner

ENV DEBIAN_FRONTEND=noninteractive
ENV NODE_ENV=production

# 1. Install Tini Init, util-linux (prlimit), libcap2-bin (capsh, used by scripts/verify-worker-container.sh), Native Conversion Engines (7-Zip and FFmpeg come from the pinned stages, FFmpeg with the runtime libraries of the codecs it was built against; libdeflate-tools is the deflate encoder for ZIP and gzip payloads past 4 MiB; lbzip2 is the bzip2 encoder for tarballs of up to two blocks; xz-utils is the .xz encoder and decoder, which the node base image installs only to unpack Node and then purges), and CJK Font Packages
# The Open CASCADE libraries (STEP and IGES, see the cadconvert stage) are packaged with occt-misc, whose 55 MB of sample models and images
# and 5 MB of resource files the program never reads (it converts all four targets of the 11 real samples with the directory removed, and
# opens nothing under it); the dpkg exclusion keeps the directory out of the image and nothing else of the package.
# fontforge-nox (FontForge without its graphical interface, GPL-3.0-or-later) reads PostScript Type 1 fonts as a separate sandboxed program; with
# --no-install-recommends it adds ten packages, 37.7 MB installed (23.4 MB of it the Python runtime library it links).
# calibre (GPL-3.0-or-later) writes the MOBI, AZW3, PDB, LRF and OEB books: the worker runs its `ebook-convert` unmodified as a separate sandboxed
# program (Qt without a display), and nothing links it into the application (docs/policy-decisions.md, "E-book targets written by calibre").
# The package depends on the Qt WebEngine and the scientific Python packages that the five targets never load; the two Qt plug-in packages are the
# image-format and SVG decoders that the books' pictures need and that the package only recommends.
RUN sed -i 's/Components: main/Components: main contrib non-free/g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || true \
    && echo 'path-exclude=/usr/share/opencascade/*' > /etc/dpkg/dpkg.cfg.d/opencascade-unused-files \
    && apt-get update \
    && EXTRA_PKGS="" \
    && if [ "$(dpkg --print-architecture)" = "amd64" ]; then \
        EXTRA_PKGS="intel-media-va-driver"; \
    fi \
    && apt-get install -y --no-install-recommends \
        tini \
        util-linux \
        libcap2-bin \
        ca-certificates \
        curl \
        libass9 \
        libdav1d7 \
        libmp3lame0 \
        libopus0 \
        libsoxr0 \
        libsvtav1enc2 \
        libtheoradec1 \
        libtheoraenc1 \
        libvorbisenc2 \
        libvpx9 \
        libwebp7 \
        libwebpmux3 \
        libx264-164 \
        libx265-215 \
        libzimg2 \
        libdrm2 \
        libva-drm2 \
        mesa-va-drivers \
        $EXTRA_PKGS \
        vainfo \
        fonts-dejavu-core \
        fonts-freefont-ttf \
        fonts-noto-cjk \
        fonts-noto-core \
        fonts-noto-ui-core \
        fonts-noto-color-emoji \
        libreoffice-calc-nogui \
        libreoffice-draw-nogui \
        libreoffice-impress-nogui \
        libreoffice-core-nogui \
        libreoffice-writer-nogui \
        libraw-bin \
        imagemagick-7.q16 \
        libheif-plugin-libde265 \
        libopenjp2-tools \
        poppler-utils \
        tesseract-ocr \
        tesseract-ocr-eng \
        tesseract-ocr-kor \
        tesseract-ocr-jpn \
        qpdf \
        ghostscript \
        librsvg2-bin \
        libavif-bin \
        default-jre-headless \
        unzip \
        libdeflate-tools \
        lbzip2 \
        xz-utils \
        libocct-data-exchange-7.8 \
        libocct-ocaf-7.8 \
        libocct-modeling-algorithms-7.8 \
        libocct-modeling-data-7.8 \
        libocct-foundation-7.8 \
        fluidsynth \
        timgm6mb-soundfont \
        fontforge-nox \
        calibre \
        qt6-image-formats-plugins \
        qt6-svg-plugins \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -r -f video && groupadd -r -f render \
    && groupadd -g 10001 -r easyconvert \
    && useradd -u 10001 -r -g easyconvert -G video,render -m -d /home/easyconvert -s /bin/bash easyconvert

# ImageMagick runs only under this policy (MAGICK_CONFIGURE_PATH names its directory on every run): root-owned and read-only. The
# directories are made first: `COPY --chmod` gives the mode of the file to the parents it creates, and a directory without the search
# bit hides the policy from the user the application runs as, which then refuses every ImageMagick conversion (503).
RUN install -d -o root -g root -m 0555 /etc/easyconvert /etc/easyconvert/imagemagick
COPY --chmod=0444 docker/imagemagick/policy.xml /etc/easyconvert/imagemagick/policy.xml
COPY --chmod=0555 scripts/verify-imagemagick-policy.sh /usr/local/bin/verify-imagemagick-policy

# Decoders of the picture formats the image library has no loader for: ImageMagick reads PSD, XCF, TGA, PCX, DDS, PNM, HEIC, HEIF and
# old-style JPEG TIFF (HEIC is HEVC-coded, which libheif decodes through its libde265 module; without recommends the module is named
# here), OpenJPEG reads JPEG 2000. Both run as separate sandboxed programs (docs/policy-decisions.md, "Pictures the image library cannot
# read"). The distribution's own ImageMagick policy file (/etc/ImageMagick-7/policy.xml on Debian 13, from imagemagick-7-common) is overwritten with
# ours, because a policy file read after ours could allow a coder again; the build fails if ImageMagick lists any policy file but ours (and that
# one) or any file that allows more than ours, if it cannot list the HEIC and PSD coders, or if a tool is missing.
RUN MAGICK="$(command -v magick || command -v magick-im7.q16)" \
    && "${MAGICK}" -list format | grep -Eq '^ +HEIC\*? +HEIC +r' \
    && "${MAGICK}" -list format | grep -Eq '^ +PSD\*? +PSD +r' \
    && dpkg -s libheif-plugin-libde265 > /dev/null \
    && for policy in /etc/ImageMagick-*/policy.xml; do if [ -e "${policy}" ]; then cp /etc/easyconvert/imagemagick/policy.xml "${policy}"; fi; done \
    && verify-imagemagick-policy "${MAGICK}" /etc/easyconvert/imagemagick \
    && runuser -u easyconvert -- verify-imagemagick-policy "${MAGICK}" /etc/easyconvert/imagemagick \
    && opj_decompress -h 2>&1 | grep -q 'OpenJPEG' \
    && dpkg-query -W -f='${binary:Package} ${Version}\n' 'libheif-plugin-*' 'libheif1*'

# 7-Zip: the statically linked upstream build is installed as `7zz`, with `7z` as an alias so
# operators and scripts find it under the usual name. The worker resolves either name.
COPY --from=sevenzip /seven-zip/7zzs /usr/local/bin/7zz
COPY --from=sevenzip /seven-zip/License.txt /usr/share/doc/7zip/License.txt
RUN ln -s 7zz /usr/local/bin/7z

# DWG reader (pinned release built in the libredwg stage). Its licence text goes to /usr/share/doc/libredwg/copyright, which the
# notices step below collects into /licenses with the system packages; the SOURCE file names the release archive it was built from.
COPY --from=libredwg /opt/libredwg/bin/dwg2dxf /usr/local/bin/dwg2dxf
COPY --from=libredwg /opt/libredwg/share/doc/libredwg /usr/share/doc/libredwg
RUN dwg2dxf --version

# EOT decompressor (pinned commit built in the libeot stage). Its licence text goes to /usr/share/doc/libeot/copyright, which the notices step
# below collects into /licenses with the system packages; the SOURCE file names the commit it was built from.
COPY --from=libeot /opt/libeot/bin/eot2ttf /usr/local/bin/eot2ttf
COPY --from=libeot /opt/libeot/share/doc/libeot /usr/share/doc/libeot
RUN eot2ttf 2>&1 | grep -q '^Usage: '

# XPS renderer (pinned release built in the ghostxps stage). Its licence text goes to /usr/share/doc/ghostxps/copyright, which the
# notices step below collects into /licenses with the system packages; the SOURCE file names the release archive it was built from.
COPY --from=ghostxps /opt/ghostxps/bin/gxps /usr/local/bin/gxps
COPY --from=ghostxps /opt/ghostxps/share/doc/ghostxps /usr/share/doc/ghostxps
RUN gxps -v

# FFmpeg (pinned release built in the ffmpeg stage). It loads its own libav* libraries from /opt/ffmpeg/lib (RUNPATH) and the codec
# libraries installed above, and is found by the worker as /usr/local/bin/ffmpeg and ffprobe; the distribution's ffmpeg package is not
# installed, or /usr/bin/ffmpeg would come first. Its licence text goes to /usr/share/doc/ffmpeg/copyright, which the notices step
# below collects into /licenses with the system packages; the SOURCE file names the release archive it was built from. The build fails
# if a library is missing or the programs do not start.
COPY --from=ffmpeg /opt/ffmpeg /opt/ffmpeg
COPY --from=ffmpeg /opt/ffmpeg/share/doc/ffmpeg /usr/share/doc/ffmpeg
RUN ln -s /opt/ffmpeg/bin/ffmpeg /usr/local/bin/ffmpeg \
    && ln -s /opt/ffmpeg/bin/ffprobe /usr/local/bin/ffprobe \
    && ! ldd /opt/ffmpeg/bin/ffmpeg /opt/ffmpeg/bin/ffprobe /opt/ffmpeg/lib/*.so.* | grep -q 'not found' \
    && test ! -e /usr/bin/ffmpeg \
    && test ! -e /usr/bin/ffprobe \
    && ffmpeg -version | head -n 1 \
    && ffprobe -version | head -n 1

# STEP and IGES reader and writer (built in the cadconvert stage). It needs the Open CASCADE runtime libraries installed above and no
# resource files; the build fails if one of them is missing or the program does not start. The libraries' licence texts are collected
# into /licenses with the other system packages by the notices step below.
COPY --from=cadconvert /usr/local/bin/cad-convert /usr/local/bin/cad-convert
RUN ! ldd /usr/local/bin/cad-convert | grep -q 'not found' \
    && cad-convert 2>&1 | grep -q 'usage: cad-convert'

# qpdf job runner (built in the qpdfrunner stage). It opens the libqpdf that the qpdf package above installs; the build fails if the library
# cannot be loaded or has no job entry (--check prints its version).
COPY --from=qpdfrunner /usr/local/bin/qpdf-runner /usr/local/bin/qpdf-runner
RUN qpdf-runner --check | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'

# MIDI renderer: FluidSynth (LGPL, run unmodified as a separate sandboxed program) turns a Standard MIDI File into sound with the General MIDI
# SoundFont of timgm6mb-soundfont (6 MB, GPL-2 data that the program only reads), which the Debian alternatives link default-GM.sf2 names.
# The build fails if the program does not start or the link leads nowhere (docs/policy-decisions.md, "MIDI sources").
RUN fluidsynth --version | grep -q 'FluidSynth runtime version' \
    && test -s /usr/share/sounds/sf2/default-GM.sf2

# PostScript Type 1 reader (fontforge-nox, installed above): the build fails if the program does not start.
RUN fontforge -lang=ff -c 'Print($version)' 2>/dev/null | grep -Eq '^[0-9]{8}$'

# E-book writer (calibre, installed above): the build fails unless `ebook-convert` starts, finds its Qt platform plug-in without a display and
# writes all five targets (MOBI, AZW3, PDB, LRF, OEB) from a text file with the options of the worker's route and its configuration in a scratch
# directory, and each result carries its format's signature: the Palm database type and creator `BOOKMOBI` (MOBI) or `TEXtREAd` (PDB), the MOBI
# version 8 (AZW3), the LRF magic, or an OPF package in the OEB folder.
RUN scratch="$(mktemp -d)" \
    && mkdir "${scratch}/config" "${scratch}/cache" "${scratch}/tmp" \
    && printf 'Hello\n' > "${scratch}/book.txt" \
    && export HOME="${scratch}" QT_QPA_PLATFORM=offscreen CALIBRE_CONFIG_DIRECTORY="${scratch}/config" \
        CALIBRE_CACHE_DIRECTORY="${scratch}/cache" CALIBRE_TEMP_DIR="${scratch}/tmp" \
    && for target in mobi azw3 pdb lrf oeb; do \
        case "${target}" in \
            mobi) set -- --mobi-file-type old --no-inline-toc ;; \
            azw3) set -- --no-inline-toc ;; \
            pdb) set -- --format doc --pdb-output-encoding cp1252 ;; \
            *) set -- ;; \
        esac; \
        timeout 120 ebook-convert "${scratch}/book.txt" "${scratch}/book.${target}" "$@" > /dev/null || exit 1; \
    done \
    && test "$(dd if="${scratch}/book.mobi" bs=1 skip=60 count=8 2> /dev/null)" = "BOOKMOBI" \
    && test "$(dd if="${scratch}/book.azw3" bs=1 skip=60 count=8 2> /dev/null)" = "BOOKMOBI" \
    && record0="$(od -An -tu4 --endian=big -j78 -N4 "${scratch}/book.azw3")" \
    && test "$(od -An -tu4 --endian=big -j$((record0 + 36)) -N4 "${scratch}/book.azw3" | tr -d ' ')" = "8" \
    && test "$(dd if="${scratch}/book.pdb" bs=1 skip=60 count=8 2> /dev/null)" = "TEXtREAd" \
    && test "$(od -An -tx1 -N8 "${scratch}/book.lrf" | tr -d ' \n')" = "4c00520046000000" \
    && find "${scratch}/book.oeb" -name '*.opf' | grep -q . \
    && rm -rf "${scratch}"

# PDF/A validator (pinned release, checksum-verified); the PDF/A post-process refuses to run without it.
COPY scripts/install-verapdf.sh /tmp/install-verapdf.sh
RUN /tmp/install-verapdf.sh /opt/verapdf && rm /tmp/install-verapdf.sh

WORKDIR /app

# 2. Copy artifacts from builder with explicit non-root ownership (production dependencies only)
COPY --from=builder --chown=easyconvert:easyconvert /app/node_modules ./node_modules
COPY --from=builder --chown=easyconvert:easyconvert /app/package*.json ./
COPY --from=builder --chown=easyconvert:easyconvert /app/dist ./dist
# sharp's libvips from the sharplibvips stage, over the copy of its npm package. The stage is mounted whole, so the build fails
# unless it holds exactly the library and its digest file, as the CI build of it does (docker/sharp-libvips/check-build-output.sh);
# check-sharp.sh then fails it unless sharp loads that library. The ownership is set with the rest of /app below.
RUN --mount=type=bind,from=sharplibvips,target=/mnt/sharplibvips \
    --mount=type=bind,source=docker/sharp-libvips,target=/mnt/sharp-libvips \
    bash /mnt/sharp-libvips/use-libvips.sh /app /mnt/sharplibvips
COPY --chown=easyconvert:easyconvert scripts/worker-healthcheck.js ./scripts/worker-healthcheck.js

# 3. Create strictly permissioned scratch directories
RUN mkdir -p /shared/storage /tmp /home/easyconvert \
    && chown -R easyconvert:easyconvert /app /shared/storage /tmp /home/easyconvert \
    && chmod 0750 /tmp /shared/storage /home/easyconvert

# 4. Copy system copyright notices and third-party notices
RUN mkdir -p /licenses \
    && copied=0 \
    && for d in /usr/share/doc/*; do \
         if [ -f "$d/copyright" ]; then \
           cp "$d/copyright" "/licenses/$(basename "$d").copyright" || exit 1; \
           copied=$((copied + 1)); \
         fi; \
       done \
    && if [ "$copied" -eq 0 ]; then echo "no copyright files found under /usr/share/doc" >&2; exit 1; fi
COPY THIRD_PARTY_NOTICES.md /licenses/
RUN cp /usr/share/doc/libredwg/SOURCE /licenses/libredwg.SOURCE
RUN cp /usr/share/doc/libeot/SOURCE /licenses/libeot.SOURCE
RUN cp /usr/share/doc/ghostxps/SOURCE /licenses/ghostxps.SOURCE
RUN cp /usr/share/doc/ffmpeg/SOURCE /licenses/ffmpeg.SOURCE
# The licence texts of the pdf.js decoders (JBIG2, OpenJPEG) sit in a subfolder of the package, which the notices file does not embed.
RUN mkdir -p /licenses/pdfjs-dist-wasm && cp /app/node_modules/pdfjs-dist/wasm/LICENSE_* /licenses/pdfjs-dist-wasm/
# The versions this image was built with (every Debian package, and the Node.js runtime), kept next to the notices.
RUN { dpkg-query -W -f='${binary:Package} ${Version}\n' | sort; printf 'nodejs %s\n' "$(node --version)"; cat /usr/share/doc/ffmpeg/tool-version.txt; } > /licenses/tool-versions.txt
RUN chmod -R a+rX /licenses

# 5. Drop to unprivileged non-root user (UID:GID 10001:10001)
USER easyconvert:easyconvert

# Healthcheck to verify Redis connectivity and worker heartbeat vitality
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD node scripts/worker-healthcheck.js || exit 1

# Process init wrapper for signal forwarding (SIGTERM/SIGINT) and zombie reaping (/usr/bin/tini -g)
ENTRYPOINT ["/usr/bin/tini", "-g", "--"]

# Start the compiled OCI worker daemon directly with Node (no npm, no tsx)
CMD ["node", "dist/worker.js"]
