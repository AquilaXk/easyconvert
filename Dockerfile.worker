# EasyConvert OCI Backend Container Worker
# Multi-architecture: linux/arm64 (OCI Ampere A1), linux/amd64
FROM node:20-bookworm-slim

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive
ENV NODE_ENV=production

# 1. Install Native Conversion Engines, Korean/CJK Fonts, and create dedicated non-root user
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    ffmpeg \
    fonts-dejavu-core \
    fonts-freefont-ttf \
    fonts-noto-cjk \
    libreoffice-calc \
    libreoffice-impress \
    libreoffice-nogpu \
    libreoffice-writer \
    p7zip-full \
    poppler-utils \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -r easyconvert && useradd -r -g easyconvert -m -s /bin/bash easyconvert

WORKDIR /app

# 2. Copy dependency manifests
COPY package*.json ./

# 3. Install production & dev dependencies with lifecycle scripts ignored for security
RUN npm ci --include=dev --ignore-scripts

# 4. Copy application source explicitly
COPY tsconfig.json ./
COPY src/ ./src/

# 5. Ensure non-root ownership for app & temp directory
RUN chown -R easyconvert:easyconvert /app

USER easyconvert

# Healthcheck to verify native tools and daemon vitality
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD node -e "require('child_process').execSync('soffice --version && ffmpeg -version')" || exit 1

# Start the OCI worker daemon
CMD ["npm", "run", "worker"]
